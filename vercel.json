{
  "installCommand": "npm install --omit=dev --no-audit --no-fund",
  "regions": [
    "cdg1"
  ],
  "headers": [
    {
      "source": "/candidates/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(favicon.svg|og.jpg|x-banner.jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
